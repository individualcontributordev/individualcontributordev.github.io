            "text": "{\"analytics_id\":\"b2022e6ba12c357bec854627576bedde\",\"messages\":[[{\"type\":0,\"content\":\"I'm going to have to test making a tiny change to a fresh CSR and then try a disc swap\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:22:37.896000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304602011588759643\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":748,\"hit\":true}],[{\"type\":0,\"content\":\"there is something very wrong with the CSR then if that is the case, if it was borked since v0.1.1, that's literally the first version \\ud83d\\ude2d\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:22:09.297000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304601891635728425\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":747,\"hit\":true}],[{\"type\":0,\"content\":\"if it was let me know what version of the CSR it was\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:17:22.277000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304600687786594385\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":738,\"hit\":true}],[{\"type\":0,\"content\":\"Ah fair enough it's fine I've burned a second D2 regular to test this. I've been working under the assumption that my PS2 and backups have been working as expected, swaps and all. But I can't seem to get backups to swap from D1 to D2 at the moment, which makes it difficult to determine if it is the CSR or just the fact it's a burned disc\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:16:03.653000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304600358013763634\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":734,\"hit\":true}],[{\"type\":0,\"content\":\"<@248225699909861376> could you test something for me when you get a chance?\\n\\nPut this save file on your PS1 mem card and start with D1 burned (not CSR), load the save, kill Jenova, don't save, swap to D2 burned (not CSR), let me know if your normal burned discs work with that save? The save is a regular disc save I pulled from Duck station, not a CSR save so should not be borked\",\"mentions\":[{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[{\"id\":\"1304596615616528424\",\"filename\":\"BASCUS-94163FF7-S02\",\"size\":8192,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1304596615616528424/BASCUS-94163FF7-S02?ex=6a6e88c7&is=6a6d3747&hm=6ccea23aa7b11803a22abda0f160df7e44fe75d95b5a0312da537abdfe608c47&\",\"proxy_url\":\"https://media.discordapp.net/attachments/1288235003901120586/1304596615616528424/BASCUS-94163FF7-S02?ex=6a6e88c7&is=6a6d3747&hm=6ccea23aa7b11803a22abda0f160df7e44fe75d95b5a0312da537abdfe608c47&\",\"content_scan_version\":2}],\"embeds\":[],\"timestamp\":\"2024-11-09T00:01:11.527000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304596616166113361\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":729,\"hit\":true}],[{\"type\":0,\"content\":\"Regular Disc 1 at Gongaga before Temple PS1 save file + level 99 Cloud, Tifa, and some of the others, for anyone interested. You'll need to copy this onto a PS1 memory card to use it with discs.\\n\\nIt also has awesomeWaves CSR Disc 1 at Jenova life save in slot 1 which was used in the test scenarios above.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[{\"id\":\"1304560715180540006\",\"filename\":\"BASCUS-94163FF7-S03\",\"size\":8192,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1304560715180540006/BASCUS-94163FF7-S03?ex=6a6e6758&is=6a6d15d8&hm=a9cb494028901c6d13f4e2f7331c75abb63b86149c6e50e38cb490f637e3f612&\",\"proxy_url\":\"https://media.discordapp.net/attachments/1288235003901120586/1304560715180540006/BASCUS-94163FF7-S03?ex=6a6e6758&is=6a6d15d8&hm=a9cb494028901c6d13f4e2f7331c75abb63b86149c6e50e38cb490f637e3f612&\",\"content_scan_version\":4}],\"embeds\":[],\"timestamp\":\"2024-11-08T21:38:32.093000+00:00\",\"edited_timestamp\":\"2024-11-08T21:42:22.707000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304560715297718365\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":726,\"hit\":true}],[{\"type\":0,\"content\":\"My assumption for remaining tests is that using a non CSR save state converted to PS1 memory card file and running through the above scenarios will show different results. Comparing the results of both save files will show that awesomeWaves save file was borked by D1 CSR. If this is true I'll need to compare the common RAM variables in both saves to determine the differences and hopefully find the issue. It's very likely going to be that a variable was not set correctly, let's see.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T19:44:23.564000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304531990485139489\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":725,\"hit\":true}],[{\"type\":0,\"content\":\"I'm going to test if deleting a script from the game decreases the file size too, my assumption here is that deleting a bunch of scripts as opposed to just moving them so they don't get executed is shifting where game data would normally live on the disc, and so when disc swap occurs the PS2 can't read the correct data because it's no longer in the right place on the disc. OR adding new scripts is shifting data.\\n\\n> D1 CSR > load save > skipped jenova > D2 regular > not working (no error noise)\\n\\nThis is why I'm thinking that, CSR moves data around and the PS2 is confused, so then tries to load a regular disc but has the wrong pointers to data because of the CSR. Other scenarios that use regular D2 during the swap seem to work fine. It's only when the CSR D1 is used does it break in this scenario.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T18:59:52.520000+00:00\",\"edited_timestamp\":\"2024-11-08T19:05:30.771000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304520787314606124\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":723,\"hit\":true}],[{\"type\":0,\"content\":\"> D1 burned > load save > fight jenova > D2 burned > not working (error noise)\\n\\nThis one is weird, this tells me there is something wrong with the save that is preventing burned D2 from loading, not related to CSR (other than the save being made on a D1 CSR run). So likely the CSR broke the save which is then preventing burned discs from loading.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T18:54:19.821000+00:00\",\"edited_timestamp\":\"2024-11-08T18:57:36.703000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304519391873863691\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":722,\"hit\":true}],[{\"type\":0,\"content\":\"Ok I've just tested this:\\n\\n- put in latest CSR D1\\n- mash through to D2 swap\\n- put in non-CSR burned D2\\n- error noise won't load\\n- put back in CSR D1\\n- it loads fine\\n\\n\\n... wtf\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T18:13:41.855000+00:00\",\"edited_timestamp\":\"2024-11-08T18:14:03.354000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304509166303314000\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":720,\"hit\":true}],[{\"type\":0,\"content\":\"What might be the difference between a normal D2 and a burned D2? ignoring CSR\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T18:04:44.247000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304506911412064358\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":719,\"hit\":true}],[{\"type\":0,\"content\":\"So I think a good next test is, load the save using the CSR, then at disc swap use a not-burned D2 to see if it loads\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T17:57:11.606000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304505012898238496\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":716,\"hit\":true}],[{\"type\":0,\"content\":\"This means your save is borked and not the CSR disc??\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T17:54:52.604000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304504429881589884\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":712,\"hit\":true}],[{\"type\":0,\"content\":\"it was made with the CSR also\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T12:01:44.160000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304415559106170913\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":702,\"hit\":true}],[{\"type\":19,\"content\":\"I got everything working I'll write some notes and send them over. I'm using SMB so sharing a folder on my PC, dropping in the CSR, then loading from PS2. It's great because there is zero input lag playing it on PS2 and it's the CSR with no discs involved but the colors are a little weird on battles so nothing major.\\n\\nBut it's still emulated, I can't reproduce the D2 issue because it just works on this, similar to Duckstation.\",\"mentions\":[{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T07:51:26.955000+00:00\",\"edited_timestamp\":\"2024-11-08T07:55:18.588000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304352572383166535\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"1288235003901120586\",\"message_id\":\"1304186244699521174\",\"guild_id\":\"936291902133796955\"},\"position\":695,\"hit\":true}],[{\"type\":0,\"content\":\"Another test: just use a normal D1, load in, fight Jenova and try go through to disc swap. No CSR this time at all. That would test the save itself\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T02:54:21.555000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304277807236517888\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":692,\"hit\":true}],[{\"type\":0,\"content\":\"Not tonight, but you could try a normal D1, load in, swap in CSR, skip over Jenova, put normal D1 back in, stuff like that\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T02:47:44.126000+00:00\",\"edited_timestamp\":\"2024-11-08T02:48:33.698000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304276140298338425\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":688,\"hit\":true}],[{\"type\":0,\"content\":\"I might keep all the discs and stick them to a piece of plywood in the order they were trashed, as a reminder of how much of a pain in the ass this CSR is lol\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T02:41:47.339000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304274643825463368\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":679,\"hit\":true}],[{\"type\":0,\"content\":\"or out of interest, remove the entire break scene from the current version of CSR\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T02:08:47.571000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304266340076355708\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":650,\"hit\":true}],[{\"type\":0,\"content\":\"I would expect this to bork if I played D1 CSR through\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-08T02:02:12.217000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304264681841623050\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":nu