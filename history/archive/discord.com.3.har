            "text": "{\"analytics_id\":\"76b9c992374486b2e020d4925fdebac4\",\"messages\":[[{\"type\":0,\"content\":\"Ok so I have the main cast in now https://youtu.be/jkaLAeB2JZU\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"video\",\"url\":\"https://www.youtube.com/watch?v=jkaLAeB2JZU\",\"title\":\"CSR break timer 2\",\"color\":16711680,\"author\":{\"name\":\"IndividualContributor\",\"url\":\"https://www.youtube.com/channel/UCLFC4xnoFlNv4OAuUYfnF6g\"},\"provider\":{\"name\":\"YouTube\",\"url\":\"https://www.youtube.com\"},\"thumbnail\":{\"url\":\"https://i.ytimg.com/vi/jkaLAeB2JZU/maxresdefault.jpg\",\"proxy_url\":\"https://images-ext-1.discordapp.net/external/ujy2jO1xcn1vL562ByfVo-RrPNBpFe96kmn5gpnE7QI/https/i.ytimg.com/vi/jkaLAeB2JZU/maxresdefault.jpg\",\"width\":1280,\"height\":720,\"content_type\":\"image/jpeg\",\"placeholder\":\"CggGFIKsCpaKh5iyWIdwaQOlRw==\",\"placeholder_version\":1,\"flags\":0},\"video\":{\"url\":\"https://www.youtube.com/embed/jkaLAeB2JZU\",\"width\":1280,\"height\":720,\"placeholder\":\"CggGFIKsCpaKh5iyWIdwaQOlRw==\",\"placeholder_version\":1,\"flags\":0}}],\"timestamp\":\"2024-10-29T22:43:03.764000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1300953075607015456\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":194,\"hit\":true}],[{\"type\":0,\"content\":\"This is the FF8 CSR break screen\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-29T21:43:55.558000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1300938193352527952\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":185,\"hit\":true}],[{\"type\":0,\"content\":\"This seems to be half way in the CSR, and coincidentally half way in the non-CSR no slots too right?\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-29T21:04:48.489000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1300928349031632968\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":173,\"hit\":true}],[{\"type\":0,\"content\":\"I'm using an OG Disc 3, but I guess because I played all the way through Disc 2 to here with the CSR that some value is incorrect\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-28T00:04:51.763000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1300248885515522080\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":127,\"hit\":true}],[{\"type\":0,\"content\":\"Hey I was wondering if the script to generate chocobo times is available anywhere? I tried searching for it but I don't see any public release of it.\\n\\nI ask because I'm running on IC's PSX CSR on PS2 and as the CSR might get shorter the IGTs might change. So rather than asking multiple times for a set of IGTs I thought it might be easier if I could generate my own. Thanks\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-27T18:02:03.678000+00:00\",\"edited_timestamp\":\"2024-10-27T18:06:25.726000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1300157583549792357\",\"channel_id\":\"944817091737964644\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"hit\":true}],[{\"type\":0,\"content\":\"https://www.twitch.tv/awesomewaves/clip/StrongDeterminedCormorant4Head-nzrI6sBy32OH4s0D\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"link\",\"url\":\"https://www.twitch.tv/awesomewaves/clip/StrongDeterminedCormorant4Head-nzrI6sBy32OH4s0D\",\"title\":\"awesomeWaves - CSR v0.3.0 Chocobo Costa Glitch\",\"description\":\"Watch awesomeWaves's clip titled \\\"CSR v0.3.0 Chocobo Costa Glitch\\\"\",\"provider\":{\"name\":\"Twitch\"},\"thumbnail\":{\"url\":\"https://static-cdn.jtvnw.net/twitch-clips-thumbnails-prod/StrongDeterminedCormorant4Head-nzrI6sBy32OH4s0D/d20cff4c-e445-4a2b-8692-f463b2ffd19a/preview.jpg\",\"proxy_url\":\"https://images-ext-1.discordapp.net/external/KNDvez6FLk2Vs6OuuvozcXlDPpZkoIvJ_0qe-16Re48/https/static-cdn.jtvnw.net/twitch-clips-thumbnails-prod/StrongDeterminedCormorant4Head-nzrI6sBy32OH4s0D/d20cff4c-e445-4a2b-8692-f463b2ffd19a/preview.jpg\",\"width\":1920,\"height\":1080,\"content_type\":\"image/jpeg\",\"placeholder\":\"lBgKHISASahaeHd1h3Y/ibTAZg==\",\"placeholder_version\":1,\"flags\":0},\"content_scan_version\":4}],\"timestamp\":\"2024-10-27T16:57:34.832000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1300141356433281114\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":117,\"hit\":true}],[{\"type\":0,\"content\":\"Preview of release v0.3.0, Start to Junon parade game test https://youtu.be/Lc3FmvNR6qo (might still be uploading so give it a little while). I got to Chocobo Ranch with an IGT of 1:10:XX and I'm shit at running <:KEKW:1074810897308069948>\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"video\",\"url\":\"https://www.youtube.com/watch?v=Lc3FmvNR6qo\",\"title\":\"Final Fantasy 7 CutScenes Removed v0.3.0 - Start to Junon parade game\",\"description\":\"GitHub repo for patch files https://github.com/individualcontributordev/Final-Fantasy-7-CSR\",\"color\":16711680,\"author\":{\"name\":\"IndividualContributor\",\"url\":\"https://www.youtube.com/channel/UCLFC4xnoFlNv4OAuUYfnF6g\"},\"provider\":{\"name\":\"YouTube\",\"url\":\"https://www.youtube.com\"},\"thumbnail\":{\"url\":\"https://i.ytimg.com/vi/Lc3FmvNR6qo/maxresdefault.jpg\",\"proxy_url\":\"https://images-ext-1.discordapp.net/external/ylC7PnA5fhsRhN9zVTQDDZ4eZp3MhFhmbLZ8k1SfcO4/https/i.ytimg.com/vi/Lc3FmvNR6qo/maxresdefault.jpg\",\"width\":1280,\"height\":720,\"content_type\":\"image/jpeg\",\"placeholder\":\"zAcKFIBkC2mxllrTGkuBQPYygw==\",\"placeholder_version\":1,\"flags\":0},\"video\":{\"url\":\"https://www.youtube.com/embed/Lc3FmvNR6qo\",\"width\":1280,\"height\":720,\"placeholder\":\"zAcKFIBkC2mxllrTGkuBQPYygw==\",\"placeholder_version\":1,\"flags\":0}}],\"timestamp\":\"2024-10-27T12:17:48.496000+00:00\",\"edited_timestamp\":\"2024-10-27T12:26:29.027000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1300070949437309000\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":111,\"hit\":true}],[{\"type\":0,\"content\":\"New release v0.3.0 https://github.com/individualcontributordev/Final-Fantasy-7-CSR\\n\\nI'm pretty sure I've addressed all feedback related to Disc 1, so given there are no more suggestions for Disc 1 it could be done? \\n\\n<@248225699909861376> <@170713534726930432> <@289891674660929538> <@785294612444479568> <@191046608064872449>\\n\\nIf you have a chance to run Disc 1 and let me know if you have anymore suggestions that would be great!\\n\\nThe most significant changes were to Temple I'd say but I was able to trim a ton from other places too.\",\"mentions\":[{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},{\"id\":\"191046608064872449\",\"username\":\"hopeproductions\",\"avatar\":\"ea6a8fcda648eb65fdae9becbd0c4fe4\",\"discriminator\":\"0\",\"public_flags\":512,\"flags\":512,\"banner\":null,\"accent_color\":null,\"global_name\":\"Hope\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},{\"id\":\"289891674660929538\",\"username\":\"teeejj0102\",\"avatar\":\"aabd4c1026f28787683c2de660f2aa57\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Teeejj\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":{\"font_id\":8,\"effect_id\":1,\"colors\":[]},\"banner_color\":null,\"clan\":null,\"primary_guild\":null},{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},{\"id\":\"785294612444479568\",\"username\":\"shoutblaster\",\"avatar\":null,\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"shoutblaster\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"article\",\"url\":\"https://github.com/individualcontributordev/Final-Fantasy-7-CSR\",\"title\":\"GitHub - individualcontributordev/Final-Fantasy-7-CSR: Final Fantas...\",\"description\":\"Final Fantasy 7 CutScenes Removed. Contribute to individualcontributordev/Final-Fantasy-7-CSR development by creating an account on GitHub.\",\"color\":1975079,\"provider\":{\"name\":\"GitHub\"},\"thumbnail\":{\"url\":\"https://opengraph.githubassets.com/3c473fccf08fc2ded3b124e14a59594b962041c6e01728c90a47306aee7c7b93/individualcontributordev/Final-Fantasy-7-CSR\",\"proxy_url\":\"https://images-ext-1.discordapp.net/external/hr_td-zx-3sDlOxmabRSafSvGFvPJzBnSHIC1du1loQ/https/opengraph.githubassets.com/3c473fccf08fc2ded3b124e14a59594b962041c6e01728c90a47306aee7c7b93/individualcontributordev/Final-Fantasy-7-CSR\",\"width\":1200,\"height\":600,\"content_type\":\"image/png\",\"placeholder\":\"/fcFBIBri8WTl2hceV+zHT/L8Q==\",\"placeholder_version\":1,\"flags\":0}}],\"timestamp\":\"2024-10-26T23:16:55.108000+00:00\",\"edited_timestamp\":\"2024-10-26T23:19:59.744000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1299874432084344832\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":104,\"hit\":true}],[{\"type\":0,\"content\":\"I've been actively testing and providing feedback to IndividualContributor on the CSR. It has all the skill checks and plays true to full Any% routes\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-25T16:05:55.314000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1299403580381462609\",\"channel_id\":\"944817091737964644\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"hit\":true}],[{\"type\":19,\"content\":\"if you check the threads of this channel, there is one for IC's CSR\",\"mentions\":[{\"id\":\"246736771067543552\",\"username\":\"doumeis\",\"avatar\":\"5570be7814759b69ac5a440e5cd0831e\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Doumeis\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-25T16:04:23.565000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1299403195558400092\",\"channel_id\":\"944817091737964644\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"944817091737964644\",\"message_id\":\"1299400962078933012\",\"guild_id\":\"936291902133796955\"},\"hit\":true}],[{\"type\":0,\"content\":\"so I'm a bit confused about the CSR versions that we have\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-25T15:54:59.673000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1299400830423797830\",\"channel_id\":\"944817091737964644\",\"author\":{\"id\":\"246736771067543552\",\"username\":\"doumeis\",\"avatar\":\"5570be7814759b69ac5a440e5cd0831e\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Doumeis\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"hit\":true}],[{\"type\":0,\"content\":\"ok should be good to pull the latest patch https://github.com/individualcontributordev/Final-Fantasy-7-CSR\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"article\",\"url\":\"https://github.com/individualcontributordev/Final-Fantasy-7-CSR\",\"title\":\"GitHub - individualcontributordev/Final-Fantasy-7-CSR: Final Fantas...\",\"description\":\"Final Fantasy 7 CutScenes Removed. Contribute to individualcontributordev/Final-Fantasy-7-CSR development by creating an account on GitHub.\",\"color\":1975079,\"provider\":{\"name\":\"GitHub\"},\"content_scan_version\":0}],\"timestamp\":\"2024-10-24T13:06:18.419000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1298995990941925436\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":95,\"hit\":true}],[{\"type\":0,\"content\":\"I'll push the latest patch that I'm working on now, starting a new game is fine for me I'm doing a run of Disc 1 now, and will checkout the Aps stuff too. I'm wondering if save states are causing the issues because your essentially saving RAM values which will remain broken if you saved on a previous patch and then load the saved state with a new patch, some issues will still be there because variables were not set correctly. I've also seen some issues using save states where I load one and then swap to the patched disc and I get double boss fights and stuff like that. I would say if you're using save states try to make a save at least 2 fields from a CSR edit, for example in temple make a save on the world map and then maybe another on the weird maze screen so that you can test entering template and the rolling rocks screen.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T19:18:46.772000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297640175266169025\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":62,\"hit\":true}],[{\"type\":0,\"content\":\"Yw. It's even giving me black screens after loading save states I would normally swap in csr for\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T18:54:30.293000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297634066350342148\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":61,\"hit\":true}],[{\"type\":0,\"content\":\"it could be something else, but to just get some practice in I loaded a state at the start of the game then manually changed disc to the new CSR. All worked as intended up until the APs exp screen. Once the fight had finished and I accepted the rewards etc, it froze at a black screen with the fanfare music still playing. Just said I'd mention it, but it might be a false error.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T16:30:18.090000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297597776380825752\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":58,\"hit\":true}],[{\"type\":0,\"content\":\"here's the save state for Duck for that issue. i tried it again and it's still the same. However, that wasn't noticed on redoing the saves so i'd assume it's already been fixed (but you can still see it on a newer version of the CSR using this save)\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[{\"id\":\"1297569245458202634\",\"filename\":\"47_Enter_Junon_MENU.sav\",\"size\":1863753,\"url\":\"https://cdn.discordapp.com/attachments/1288235003901120586/1297569245458202634/47_Enter_Junon_MENU.sav?ex=6a6e0487&is=6a6cb307&hm=7bf7cad8919a8701d6334e7bbe8672ab06d9dc9a8c7813866f6320f23d4355f7&\",\"proxy_url\":\"https://media.discordapp.net/attachments/1288235003901120586/1297569245458202634/47_Enter_Junon_MENU.sav?ex=6a6e0487&is=6a6cb307&hm=7bf7cad8919a8701d6334e7bbe8672ab06d9dc9a8c7813866f6320f23d4355f7&\",\"content_scan_version\":0,\"title\":\"47 Enter Junon MENU\"}],\"embeds\":[],\"timestamp\":\"2024-10-20T14:36:55.926000+00:00\",\"edited_timestamp\":\"2024-10-20T14:37:35.575000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1297569246036885515\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":52,\"hit\":true}],[{\"type\":4,\"content\":\"Final Fantasy 7 CSR Patches (IndividualContributor)\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-20T09:33:44.596000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1297492946068836433\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":51,\"hit\":true}],[{\"type\":0,\"content\":\"I wish I had more time to try it out myself, but waves has been embracing csr's longer than anyone I know so his feedback is incredibly valuable\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-17T12:23:48.983000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1296448582773112832\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":46,\"hit\":true}],[{\"type\":0,\"content\":\"I'll test it anyway but maybe it was something on an older patch version that I'm unlikely to be able to reproduce, let's see. The latest patch has a ton of new stuff to shorten the CSR even further so definitely worth a go. \\n\\nAnd I'm getting close to finalizing the whole thing because I don't want to be updating it while others are running it and getting times.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-16T12:04:24.317000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1296081309944254494\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":34,\"hit\":true}],[{\"type\":0,\"content\":\"No i don't think so, I only pointed Duckstation to the CSR files folder for the entire time I was making these saves\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-10-16T12:00:13.287000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1296080257048252498\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":33,\"hit\":true}],[{\"type\":0,\"content\":\"Here is the link again https://github.com/individualcontributordev/FF7-PSX-Disc-CSR-Patches\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"article\",\"url\":\"https://github.com/individualcontributordev/FF7-PSX-Disc-CSR-Patches\",\"title\":\"GitHub - individualcontributordev/FF7-PSX-Disc-CSR-Patches\",\"description\":\"Contribute to individualcontributordev/FF7-PSX-Disc-CSR-Patches development by creating an account on GitHub.\",\"color\":1975079,\"provider\":{\"name\":\"GitHub\"},\"thumbnail\":{\"url\":\"https://opengraph.githubassets.com/4f7ffed58de6551cb4e9167b6f505587553988d3df39c059f4f9425e84e827e4/individualcontributordev/FF7-PSX-Disc-CSR-Patches\",\"proxy_url\":\"https://images-ext-1.discordapp.net/external/HyJIk1g3NdiWPXP2motmEFYHMZC-D2TwYC_WaMM92FM/https/opengraph.githubassets.com/4f7ffed58de6551cb4e9167b6f505587553988d3df39c059f4f9425e84e827e4/individualcontributordev/FF7-PSX-Disc-CSR-Patches\",\"width\":1200,\"height\":600,\"content_type\":\"image/png\",\"placeholder\":\"/fcFBIBrm8WSl2lbeW+zDS7L8A==\",\"placeholder_version\":1,\"flags\":0}}],\"timestamp\":\"2024-10-05T12:47:37.486000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1292105919961894955\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":16,\"hit\":true}],[{\"type\":18,\"content\":\"Final Fantasy 7 PS1 Disc CSR Patches (IndividualContributor)\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-09-29T14:51:16.987000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1289962712410882053\",\"channel_id\":\"944817091737964644\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"1288235003901120586\",\"guild_id\":\"936291902133796955\"},\"hit\":true}],[{\"type\":0,\"content\":\"I made a CSR for any% and 100% (including variants NMS, All Bosses, etc.). I've only made patches for disc 1 and 2, I didn't touch disc 3 because there was no point. I've tested these by burning them to a disc and running it in my PS2 Slim (MechaPwn'd to play NTSC and backups).  But they also work for Emulator/Digital. Curious to know if anyone would be interested in further testing these? and if you have any suggestions?  \\n\\nApply the patches to your FF7 NTSC/US PS1 .bin files.\\n\\n## Steps\\n\\n1. Go to https://www.romhacking.net/patch/\\n2. Select your original .bin file, ignore the \\\"file too big\\\" warning\\n3. Select the patch .ppf file\\n4. Click the \\\"Apply patch\\\" button\\n\\nYour browser should download a new patched version of the disc.\\n\\nYou can burn the patched version to disc or load it up in an emulator (I used duckstation version 0.1-7371-gb2577ef8b (dev) for testing). I used ImgBurn with write speed 16x on Verbatim CD-R 700MB discs.\\n\\n## Details\\n\\nThese patches remove most if not all FMVs, shortens some in-game cutscenes, and reduces some mashing sequences.\\n\\n**All \\\"skill checks\\\" are present in this CSR, if not let me know and I'll fix it.**\\n\\nLatest patch releases are on GitHub https://github.com/individualcontributordev/Final-Fantasy-7-CSR\\n\\nChange log https://github.com/individualcontributordev/Final-Fantasy-7-CSR/blob/main/CHANGELOG.md\\n\\nDiscussion on bugs and fixes in thread \\ud83e\\uddf5\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-09-24T20:25:59.179000+00:00\",\"edited_timestamp\":\"2024-10-26T23:22:36.031000+00:00\",\"flags\":36,\"components\":[],\"id\":\"1288235003901120586\",\"channel_id\":\"944817091737964644\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"thread\":{\"id\":\"1288235003901120586\",\"type\":11,\"last_message_id\":\"1308221962883043339\",\"flags\":0,\"guild_id\":\"936291902133796955\",\"name\":\"Final Fantasy 7 CSR Patches (IndividualContributor)\",\"parent_id\":\"944817091737964644\",\"rate_limit_per_user\":0,\"bitrate\":64000,\"user_limit\":0,\"rtc_region\":null,\"owner_id\":\"183261151746850816\",\"thread_metadata\":{\"archived\":true,\"archive_timestamp\":\"2024-12-19T00:11:24.513000+00:00\",\"auto_archive_duration\":4320,\"locked\":false,\"create_timestamp\":\"2024-09-29T14:51:16.973000+00:00\"},\"message_count\":1352,\"member_count\":9,\"total_message_sent\":1378,\"member_ids_preview\":[\"132969911239704576\",\"289891674660929538\",\"183261151746850816\",\"191046608064872449\",\"170713534726930432\"]},\"hit\":true}],[{\"type\":0,\"content\":\"Would it make sense to post the CSR into resources-no-discussion?\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-05-31T20:26:57.799000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1246198257361879200\",\"channel_id\":\"944817091737964644\",\"author\":{\"id\":\"250110899321438209\",\"username\":\"lemon6559\",\"avatar\":\"73f24aeef6cbb1b1e58e6c1813ef41c4\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"lemon\",\"avatar_decoration_data\":null,\"collectibles\":{\"nameplate\":{\"sku_id\":\"1409983105577783410\",\"asset\":\"nameplates/special_events_2/nitro_rocketfuel_nameplate/\",\"label\":\"COLLECTIBLES_SEPTEMBER_2025_MARKETING_NAMEPLATE_A11Y\",\"palette\":\"violet\"}},\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"hit\":true}],[{\"type\":0,\"content\":\"Nice. I also remembered the ffx discord having them too, that's how I learned how to do CSR\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[{\"id\":\"1004967190165995560\",\"filename\":\"unknown.png\",\"size\":20573,\"url\":\"https://cdn.discordapp.com/attachments/944817091737964644/1004967190165995560/unknown.png?ex=6a6e1ce1&is=6a6ccb61&hm=633e6168cb5ea65b73cab247bd39856a5694c