olor\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-14T00:01:06.614000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1306408534887501975\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"message_reference\":{\"type\":0,\"channel_id\":\"1288235003901120586\",\"message_id\":\"1306408247032283167\",\"guild_id\":\"936291902133796955\"},\"position\":1190,\"hit\":true}],[{\"type\":0,\"content\":\"Like we're not treating mashing as a skill check in a CSR right\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-13T23:56:36.903000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1306407403637702707\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"191046608064872449\",\"username\":\"hopeproductions\",\"avatar\":\"ea6a8fcda648eb65fdae9becbd0c4fe4\",\"discriminator\":\"0\",\"public_flags\":512,\"flags\":512,\"banner\":null,\"accent_color\":null,\"global_name\":\"Hope\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":1177,\"hit\":true}],[{\"type\":0,\"content\":\"If you have any suggestions I'd appreciate them submitted here https://forms.gle/dW9rMCD9kQ3eBPSM8 so I can keep track of what's left to do\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"link\",\"url\":\"https://forms.gle/dW9rMCD9kQ3eBPSM8\",\"title\":\"FF7 CutScenes Removed Feature and Bug Fix Requests\",\"description\":\"FF7 CSR https://github.com/individualcontributordev/Final-Fantasy-7-CSR\\n\\nDiscord thread https://discord.com/channels/936291902133796955/1288235003901120586\\n\\nSend @individualcontributor a message on Twitch or in the Discord if you have questions\",\"provider\":{\"name\":\"Google Docs\"},\"thumbnail\":{\"url\":\"https://lh4.googleusercontent.com/VfOp4eNHKLymzruMxp-F70y99_Qsp67JhAG3JfAxAw0MNQ_DOrYgRhlI3Qac-K5ToRY2pa-b0qk=w1200-h630-p\",\"proxy_url\":\"https://images-ext-1.discordapp.net/external/p7Cvwfezh6jXxMCmHN7UGcfzWvnUsEmq1HeJxN_7slY/https/lh4.googleusercontent.com/VfOp4eNHKLymzruMxp-F70y99_Qsp67JhAG3JfAxAw0MNQ_DOrYgRhlI3Qac-K5ToRY2pa-b0qk%3Dw1200-h630-p\",\"width\":1200,\"height\":630,\"content_type\":\"image/png\",\"placeholder\":\"t/cJDILHmHeAe4mFeXjYgIUNVw==\",\"placeholder_version\":1,\"flags\":0},\"content_scan_version\":4}],\"timestamp\":\"2024-11-13T23:48:33.735000+00:00\",\"edited_timestamp\":null,\"flags\":1024,\"components\":[],\"id\":\"1306405377084231761\",\"channel_id\":\"944817091737964644\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"hit\":true}],[{\"type\":0,\"content\":\"And I'll be doing the CSR all the way through for 100% too. I'm not sure yet what will be left after any% is done, but I'm sure there will be enough to warrant trimming a bit more. NMS is on the list too. I already have Reactor 5 done lol.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-13T23:46:59.936000+00:00\",\"edited_timestamp\":\"2024-11-13T23:47:41.126000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1306404983662444635\",\"channel_id\":\"944817091737964644\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"hit\":true}],[{\"type\":0,\"content\":\"<@456226577798135808> It does! it will be quicker too because the CSR is exactly like a non-CSR run except a bunch of FMVs are cut and some mashing sections are reduced. Anywhere there is player movement required is left in, but could be trimmed around it while leaving in queues and stuff.\\n\\nThis is the definition I have on the repo for the CSR:\\n\\nAll \\\"skill checks\\\" remain in this CSR (if not let me know and I'll fix it). A skill check is any action a player must perform in game, e.g. choosing an option in dialogues, movement in cutscenes, skips, manipulating RNG, etc. Most FMVs are removed, some cutscenes are shorter, and long mashing sequences have been reduced. This CSR is exactly like a non-CSR run, just shorter.\",\"mentions\":[{\"id\":\"456226577798135808\",\"username\":\"Deleted User\",\"avatar\":null,\"discriminator\":\"0000\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":null,\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-13T23:44:48.251000+00:00\",\"edited_timestamp\":\"2024-11-13T23:45:29.587000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1306404431335522305\",\"channel_id\":\"944817091737964644\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"hit\":true}]],\"doing_deep_historical_index\":false,\"total_results\":150,\"threads\":[{\"id\":\"1288235003901120586\",\"type\":11,\"last_message_id\":\"1308221962883043339\",\"flags\":0,\"guild_id\":\"936291902133796955\",\"name\":\"Final Fantasy 7 CSR Patches (IndividualContributor)\",\"parent_id\":\"944817091737964644\",\"rate_limit_per_user\":0,\"bitrate\":64000,\"user_limit\":0,\"rtc_region\":null,\"owner_id\":\"183261151746850816\",\"thread_metadata\":{\"archived\":true,\"archive_timestamp\":\"2024-12-19T00:11:24.513000+00:00\",\"auto_archive_duration\":4320,\"locked\":false,\"create_timestamp\":\"2024-09-29T14:51:16.973000+00:00\"},\"message_count\":1352,\"member_count\":9,\"total_message_sent\":1378,\"member_ids_preview\":[\"132969911239704576\",\"289891674660929538\",\"183261151746850816\",\"191046608064872449\",\"170713534726930432\"]}],\"members\":[{\"id\":\"1288235003901120586\",\"user_id\":\"183261151746850816\",\"join_timestamp\":\"2024-09-29T14:51:16.974000+00:00\",\"flags\":3,\"muted\":false,\"mute_config\":null}]}\n"
