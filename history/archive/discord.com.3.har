".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":605,\"hit\":true}],[{\"type\":0,\"content\":\"Which is what I'll be using over the network too, so if I can get this working it seems like the CSR will be running in the same environment, either over network or burned disc.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-07T22:13:19.533000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304207082790322289\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":602,\"hit\":true}]],\"doing_deep_historical_index\":false,\"total_results\":150,\"threads\":[{\"id\":\"1288235003901120586\",\"type\":11,\"last_message_id\":\"1308221962883043339\",\"flags\":0,\"guild_id\":\"936291902133796955\",\"name\":\"Final Fantasy 7 CSR Patches (IndividualContributor)\",\"parent_id\":\"944817091737964644\",\"rate_limit_per_user\":0,\"bitrate\":64000,\"user_limit\":0,\"rtc_region\":null,\"owner_id\":\"183261151746850816\",\"thread_metadata\":{\"archived\":true,\"archive_timestamp\":\"2024-12-19T00:11:24.513000+00:00\",\"auto_archive_duration\":4320,\"locked\":false,\"create_timestamp\":\"2024-09-29T14:51:16.973000+00:00\