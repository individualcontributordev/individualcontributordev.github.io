            "text": "{\"analytics_id\":\"bc17e2437c8f30f195084328fb6153f2\",\"messages\":[[{\"type\":0,\"content\":\"I'm testing using a regular burned D2 not a CSR D2 to eliminate D2 CSR from the problem.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T15:28:19.103000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304829935130771477\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":927,\"hit\":true}],[{\"type\":0,\"content\":\"So I just tried waves save with my first IC CSR burns and I got into disc 2\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T15:19:43.436000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304827772266348625\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":915,\"hit\":true}],[{\"type\":0,\"content\":\"well, the save I used was from the current CSR 0.4.7 so i assume it should be broken also\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T15:00:59.197000+00:00\",\"edited_timestamp\":\"2024-11-09T15:03:35.993000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304823056866344970\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":897,\"hit\":true}],[{\"type\":0,\"content\":\"At that save from a non-CSR run\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T14:59:17.405000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304822629919621170\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":892,\"hit\":true}],[{\"type\":0,\"content\":\"https://github.com/individualcontributordev/Final-Fantasy-7-CSR/blob/783be7dc1e88c45287371bf537cd160af0dfe0a7/Final%20Fantasy%20VII%20(Disc%201)%20CSR%20Patch.ppf\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[{\"type\":\"article\",\"url\":\"https://github.com/individualcontributordev/Final-Fantasy-7-CSR/blob/783be7dc1e88c45287371bf537cd160af0dfe0a7/Final%20Fantasy%20VII%20(Disc%201)%20CSR%20Patch.ppf\",\"title\":\"Final-Fantasy-7-CSR/Final Fantasy VII (Disc 1) CSR Patch.ppf at 783...\",\"description\":\"Final Fantasy 7 CutScenes Removed. Contribute to individualcontributordev/Final-Fantasy-7-CSR development by creating an account on GitHub.\",\"color\":1975079,\"provider\":{\"name\":\"GitHub\"},\"thumbnail\":{\"url\":\"https://opengraph.githubassets.com/9ec20b5a7c9ea0152d56571baded620f3ea92731b443aeebdc8b22e07a022725/individualcontributordev/Final-Fantasy-7-CSR\",\"proxy_url\":\"https://images-ext-1.discordapp.net/external/3krDLeU1p1uHkgtvsw3Pc_um5kqDa_ry8hmFzfAc568/https/opengraph.githubassets.com/9ec20b5a7c9ea0152d56571baded620f3ea92731b443aeebdc8b22e07a022725/individualcontributordev/Final-Fantasy-7-CSR\",\"width\":1200,\"height\":600,\"content_type\":\"image/png\",\"placeholder\":\"/fcFBIBri8WTl2hceV+zHT/L8Q==\",\"placeholder_version\":1,\"flags\":0},\"content_scan_version\":4}],\"timestamp\":\"2024-11-09T14:41:44.854000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304818215200886804\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":883,\"hit\":true}],[{\"type\":0,\"content\":\"**Testing using non-CSR save at JenovaLife, same save file as previous testing**\\n\\nSave file https://discord.com/channels/936291902133796955/1288235003901120586/1304830909266001920\\n\\nFresh .bin of D1 with changes:\\n- significant changes made to Jenova life section to align with changes in latest v0.4.9: disc swap D1 > D2 works as expected\\n- + skipped intro: disc swap D1 > D2 works as expected (I wanted to see if this was causing the issue, it's not)\\n\\n\\nAdditional tests:\\n- v0.4.9: disc swap D1 > D2 does not work\\n- v0.1.1: disc swap D1 > D2 does not work\\n\\n\\nResults of these tests show that:\\n- making any kind of change to the scripts/code does not break the disc swapping mechanism on PSX, D2 > D3 currently works in v0.4.9 and these tests confirm that D1 > D2 disc swapping works with significant modifications, so something I did specifically is breaking disc swap\\n- changes to the JenovaLife section from v0.1.1. to v0.4.9 are not causing the issue, the issue was introduced prior to v0.1.1, tests showed that making changes similar to those that are present in v0.4.9 in the JenovaLife section allows the disc swapping D1 > D2 to work as expected, and also just testing the v0.1.1 patch breaks the D1 > D2 swapping, not working as expected\\n\\n\\nNext steps, burn a patch prior to v0.1.1 and test the disc swapping. Do a binary search on versions prior to v0.1.1, burn them and test to narrow down where the issue was introduced.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T11:09:13.556000+00:00\",\"edited_timestamp\":\"2024-11-09T22:47:57.770000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304764732380680212\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":878,\"hit\":true}],[{\"type\":0,\"content\":\"CSR workstation lol\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T10:17:33.054000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304751727932739616\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":877,\"hit\":true}],[{\"type\":0,\"content\":\"well sheet ok so D1 v0.1.1 loading straight into the jenova saves from earlier, fighting Jenova, disc swap to D2 burned (not CSR / no modifications) is NOT working.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T02:06:06.659000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304628053028245525\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":865,\"hit\":true}],[{\"type\":0,\"content\":\"Here's what we know so far:\\n\\n- file sizes for .bin files stays the same after patching\\n- previous CSR save files are not breaking the D1 to D2 swapping on CSR\\n- the disc swap issue was introduced in v0.1.1\\n\\nNext tests:\\n\\n- start from a fresh .bin, make a small change near D1 to D2 disc swap (jenova fight skip), skip from start to jenova, burn to disc, test in ps2 for disc swap issue\\n  - the result of this test will determine if any small change to the .bin breaks the D1 to D2 disc swap loading\\n\\n- if making a small change does not break disc swap loading, then start reverting changes made in v0.1.1 until it works... more detail on this later\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T01:33:10.681000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304619765175685121\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":836,\"hit\":true}],[{\"type\":0,\"content\":\"On GitHub it says 0.1.1 was updated 2 weeks ago. Is that still the same version as your very first CSR for 7?\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T01:20:07.106000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304616478624190525\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":827,\"hit\":true}],[{\"type\":0,\"content\":\"Here are my test results from today:\\n\\nTested on PS2 Slim MechaPwn'd NTSC/U using physical discs and physical memory card with save files\\n\\n\\nD1 -> Disc 1\\nD2 -> Disc 2\\nregular -> not burned discs\\nburned -> burned discs with no modifications\\nCSR -> burned discs with modifications\\n\\n\\n**awesomeWaves CSR PS1 memcard file converted to .mcd then converted back to PS1 memcard file, before Jenova**\\n\\nD1 regular > load save > fight jenova > D2 regular > works fine\\nD1 regular > load save > fight jenova > D2 burned > works fine\\n\\nD1 burned > load save > fight jenova > D2 regular > works fine\\nD1 burned > load save > fight jenova > D2 burned > works fine\\n\\nD1 CSR > load save > skipped jenova > D2 regular > not working (no error noise)\\nD1 CSR > load save > skipped jenova > D2 burned > not working (no error noise)\\n\\n\\n \\n**IC non-CSR savestate file converted to PS1 memcard file, before Jenova**\\n\\nD1 regular > load save > fight jenova > D2 regular > works fine\\nD1 regular > load save > fight jenova > D2 burned > works fine\\n\\nD1 burned > load save > fight jenova > D2 regular > works fine\\nD1 burned > load save > fight jenova > D2 burned > works fine\\n\\nD1 CSR > load save > skipped jenova > D2 regular > not working (no error noise)\\nD1 CSR > load save > skipped jenova > D2 burned > not working (no error noise)\\n\\nThere are no differences between the results sets for 1) CSR save file and 2) non-CSR save file\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T01:18:37.640000+00:00\",\"edited_timestamp\":\"2024-11-09T01:20:24.014000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304616103376588830\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":826,\"hit\":true}],[{\"type\":0,\"content\":\"If we can get a full run of v0.1.1 CSR all the way to disc swap on PSX into a regular burned D2 and continue that would eliminate v0.1.1 being the problem.\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T01:18:09.479000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304615985260527626\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":825,\"hit\":true}],[{\"type\":0,\"content\":\"Not sure which iteration this disc 2 is though, can you remember where the first place you trimmed disc 2 on the first csr version was?\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T01:16:28.252000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304615560683716678\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":824,\"hit\":true}],[{\"type\":0,\"content\":\"So I managed to swap to burned disc 2 from the original CSR disc 1 (with the Don Corneo basement softlock) just fine\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T01:15:46.970000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304615387534721025\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":823,\"hit\":true}],[{\"type\":0,\"content\":\"Also, the file sizes of the .bin files for D1 and D2 are the same for both regular and CSR so data being shited due to scripts being removed/moved/added etc. is not the issue\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T01:05:46.433000+00:00\",\"edited_timestamp\":\"2024-11-09T01:06:26.573000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304612868699717696\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":821,\"hit\":true}],[{\"type\":0,\"content\":\"It's actually jus the CSR kekw, and loading your save on regular or burned discs works fine on disc swap\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T01:01:59.629000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304611917414797424\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":820,\"hit\":true}],[{\"type\":0,\"content\":\"So the save is not borked from D1 CSR\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T01:01:24.229000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304611768936693781\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":819,\"hit\":true}],[{\"type\":0,\"content\":\"I think skipping the disc swap might work and just putting D2 CSR in on the break\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:55:02.265000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304610166863433779\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":812,\"hit\":true}],[{\"type\":0,\"content\":\"FF8 doesn't have a PSX CSR\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:53:38.781000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304609816706289686\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":808,\"hit\":true}],[{\"type\":0,\"content\":\"What versions of the CSR have been burned to disc and run on PSX? <@248225699909861376> <@170713534726930432>\",\"mentions\":[{\"id\":\"170713534726930432\",\"username\":\".okamikaze\",\"avatar\":\"95b696448d658de94544ca767feb61f0\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"Okamikaze\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null}],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:42:51.874000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304607103381409885\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":786,\"hit\":true}],[{\"type\":0,\"content\":\"is it actually possible to just put the entire CSR on one disc?\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:32:27.215000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304604483371663430\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":774,\"hit\":true}],[{\"type\":0,\"content\":\"leaving in D1 CSR and skipping over the disc swaps will bork the elevator FMVs and stuff like that iirc, but might not if we actually put D2 CSR in\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:32:04.248000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304604387041083455\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":772,\"hit\":true}],[{\"type\":0,\"content\":\"I wonder would skipping the disc swap work, and just putting the break scene in instead, during the break you swap in D2 CSR and see what happens\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:30:56.992000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304604104949104650\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":769,\"hit\":true}],[{\"type\":0,\"content\":\"then see if it loads a CSR D2?\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:27:48.769000+00:00\",\"edited_timestamp\":null,\"flags\":0,\"components\":[],\"id\":\"1304603315484622951\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"248225699909861376\",\"username\":\"awesomewaves\",\"avatar\":\"7de794a8a3e242252076a10784af0a9f\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"awesomeWaves\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":766,\"hit\":true}],[{\"type\":0,\"content\":\"So a workaround for now could be to swap into a regular disc 2 to load and stay on formations, then just open the tray and put in D2 CSR\",\"mentions\":[],\"mention_roles\":[],\"attachments\":[],\"embeds\":[],\"timestamp\":\"2024-11-09T00:25:36.947000+00:00\",\"edited_timestamp\":\"2024-11-09T00:25:55.878000+00:00\",\"flags\":0,\"components\":[],\"id\":\"1304602762583212092\",\"channel_id\":\"1288235003901120586\",\"author\":{\"id\":\"183261151746850816\",\"username\":\"individualcontributor\",\"avatar\":\"b7271f16ff804f9fa069bba774b3d0e7\",\"discriminator\":\"0\",\"public_flags\":0,\"flags\":0,\"banner\":null,\"accent_color\":null,\"global_name\":\"IndividualContributor\",\"avatar_decoration_data\":null,\"collectibles\":null,\"display_name_styles\":null,\"banner_color\":null,\"clan\":null,\"primary_guild\":null},\"pinned\":false,\"mention_everyone\":false,\"tts\":false,\"position\":757,\"hit\":true}]],\"doing_deep_historical_index\":false,\"total_results\":150,\"threads\":[{\"id\":\"1288235003901120586\",\"type\":11,\"last_message_id\":\"1308221962883043339\",\"flags\":0,\"guild_id\":\"936291902133796955\",\"name\":\"Final Fantasy 7 CSR Patches (IndividualContributor)\",\"parent_id\":\"944817091737964644\",\"rate_limit_per_user\":0,\"bitrate\":64000,\"user_limit\":0,\"rtc_region\":null,\"owner_id\":\"183261151746850816\",\"thread_metadata\":{\"archived\":true,\"archive_timestamp\":\"2024-12-19T00:11:24.513000+00:00\",\"auto_archive_duration\":4320,\"locked\":false,\"create_timestamp\":\"2024-09-29T14:51:16.973000+00:00\"},\"message_count\":1352,\"member_count\":9,\"total_message_sent\":1378,\"member_ids_preview\":[\"132969911239704576\",\"289891674660929538\",\"183261151746850816\",\"191046608064872449\",\"170713534726930432\"]}],\"members\":[{\"id\":\"1288235003901120586\",\"user_id\":\"183261151746850816\",